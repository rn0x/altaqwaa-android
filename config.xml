<?xml version="1.0" encoding="UTF-8"?>
  <widget id="com.rn0x.altaqwaa" version="3.1.0" android-versionCode="30100" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">

  <name>التقوى</name>
  <description>تطبيق التقوى — تطبيق إسلامي متكامل</description>
  <author email="rn0x.me@gmail.com" href="https://i8x.net">Rayan Almalki</author>

  <content src="index.html" />
  <access origin="*" />

  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />
  <allow-intent href="mailto:*" />

  <preference name="orientation" value="portrait" />
  <preference name="BackgroundColor" value="#0a1428" />
  <preference name="StatusBarBackgroundColor" value="#0a1428" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="android-targetSdkVersion" value="36" />
  <preference name="AndroidXEnabled" value="true" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <preference name="loadUrlTimeoutValue" value="70000" />
  <preference name="hostname" value="localhost" />

  <platform name="android">
    <engine name="cordova-android" spec="15.1.0" />
    <preference name="deployment-target" value="13.0" />

    <!-- Launcher icons (adaptive + legacy), generated from src/resources/icons -->
    <icon density="ldpi" src="res/icon/android/ic-ldpi.png" foreground="res/icon/android/fg-ldpi.png" background="res/icon/android/bg-ldpi.png" monochrome="res/icon/android/mono-ldpi.png" />
    <icon density="mdpi" src="res/icon/android/ic-mdpi.png" foreground="res/icon/android/fg-mdpi.png" background="res/icon/android/bg-mdpi.png" monochrome="res/icon/android/mono-mdpi.png" />
    <icon density="hdpi" src="res/icon/android/ic-hdpi.png" foreground="res/icon/android/fg-hdpi.png" background="res/icon/android/bg-hdpi.png" monochrome="res/icon/android/mono-hdpi.png" />
    <icon density="xhdpi" src="res/icon/android/ic-xhdpi.png" foreground="res/icon/android/fg-xhdpi.png" background="res/icon/android/bg-xhdpi.png" monochrome="res/icon/android/mono-xhdpi.png" />
    <icon density="xxhdpi" src="res/icon/android/ic-xxhdpi.png" foreground="res/icon/android/fg-xxhdpi.png" background="res/icon/android/bg-xxhdpi.png" monochrome="res/icon/android/mono-xxhdpi.png" />
    <icon density="xxxhdpi" src="res/icon/android/ic-xxxhdpi.png" foreground="res/icon/android/fg-xxxhdpi.png" background="res/icon/android/bg-xxxhdpi.png" monochrome="res/icon/android/mono-xxxhdpi.png" />

    <!-- Native splash: the Android 12+ system splash is mandatory and cannot
         be disabled. Instead of drawing the icon (which would duplicate the
         in-app splash a moment later), paint it as a bare navy screen: fully
         transparent animated icon, navy background and navy icon circle, zero
         animation. The in-app splash (index.html #app-splash) is therefore the
         only branded splash the user ever sees. -->
    <preference name="AndroidWindowSplashScreenBackground" value="#0a1428" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/screen/android/splash-transparent.png" />
    <preference name="AndroidWindowSplashScreenIconBackgroundColor" value="#0a1428" />
    <preference name="AndroidWindowSplashScreenAnimationDuration" value="0" />
  </platform>

  <!-- Runs after `cordova prepare` and before compiling: strips the stale
       foreground-service manifest entries that cordova itself cannot remove. -->
  <hook src="scripts/patch-manifest.mjs" type="before_compile" />
  <hook src="scripts/patch-mainactivity.mjs" type="before_compile" />
</widget>